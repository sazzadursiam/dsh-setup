# ---- Secrets: never commit ----
.env
.env.*
!.env.example
*.local
secrets.*
**/credentials*
**/.credentials*
*.pem
*.key

# dsh profile — holds API keys in .credentials.yaml
.dsh/

# Figma bridge plugin — generated per machine
.figma-console-mcp/

# ---- Node ----
node_modules/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/

# ---- Build output ----
dist/
build/
.next/
out/
*.tsbuildinfo

# ---- Editors ----
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*~

# ---- OS ----
Thumbs.db
Desktop.ini
.DS_Store

# ---- Backups ----
*.bak
*.orig

# ---- Local ----
# Your own machine-specific agent rules, appended to ~/.dsh/AGENTS.md by
# agents.sh / agents.bat. Yours, not shipped. See templates/local.example.md.
local.md

# Claude Code's per-machine settings — permission grants and absolute paths of
# whoever ran it, of no use to anyone else. `*.local` above does not match
# `settings.local.json`, so it is listed here.
.claude/settings.json
.claude/settings.local.json

# Bengali translations are maintained locally, not shipped. Keeping them in the
# repo meant every doc change had to be made twice.
*.bn.md