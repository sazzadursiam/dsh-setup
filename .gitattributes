# Line ending normalization.
#
# .bat MUST be CRLF. cmd.exe's batch parser assumes CRLF; with LF-only files
# it misparses labels (:failed), goto targets, and multi-line if () blocks.

* text=auto

*.bat        text eol=crlf
*.cmd        text eol=crlf

*.sh         text eol=lf
*.md         text eol=lf
*.txt        text eol=lf
VERSION      text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
.env.example text eol=lf
.gitignore   text eol=lf
.gitattributes text eol=lf
