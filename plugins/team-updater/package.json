{
  "name": "dsh-team-updater",
  "version": "0.1.0",
  "description": "In-GUI update button for a dsh install: checks the npm registry and applies a staged self-update after dsh exits.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "deepseek",
    "updater",
    "self-update",
    "plugin"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT"
}
