# Environment variables required by this setup.
#
# These are NOT read from a file — dsh reads them from the system environment.
# This file exists only to document what you need to set.
#
# Windows (cmd), then open a NEW terminal:
#   setx FIGMA_ACCESS_TOKEN "figd_..."
#   setx ENABLE_MCP_APPS true
#
# Mac / Linux — add to ~/.zshrc or ~/.bashrc:
#   export FIGMA_ACCESS_TOKEN="figd_..."
#   export ENABLE_MCP_APPS=true

# Figma Personal Access Token. Starts with figd_
# Get it: figma.com > Settings > Security > Personal access tokens
# Scopes: see SETUP.md, part 6, step 2
FIGMA_ACCESS_TOKEN=figd_replace_me

# Enables MCP Apps support in figma-console-mcp
ENABLE_MCP_APPS=true

# NOTE: the Anthropic API key is NOT an environment variable here.
# Enter it in the dsh UI: Settings > Models > Anthropic
# Get it: console.anthropic.com
